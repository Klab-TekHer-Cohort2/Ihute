DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
JWT_SECRET=<generate_a_long_random_string>

# IHUTE RAG assistant (Colab + Cloudflare). The URL changes every time Colab restarts.
IHUTE_RAG_URL=https://<your-tunnel>.trycloudflare.com
# Optional: only if the Colab secret IHUTE_API_KEY is set (sent as X-API-Key)
IHUTE_API_KEY=
